# Deep Harness Environment Configuration

# LLM_PROVIDER: bedrock (open-source, default) | openai_compatible | mock
LLM_PROVIDER=bedrock
AWS_PROFILE=my-second-account
AWS_REGION=us-east-1
BEDROCK_CHAT_MODEL_ID=us.meta.llama3-3-70b-instruct-v1:0
BEDROCK_FALLBACK_MODEL_ID=mistral.mistral-large-3-675b-instruct
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBED_ENABLED=false
BEDROCK_EMBED_DIMENSION=1024

# OpenAI-compatible fallback (only if LLM_PROVIDER=openai_compatible)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Database & memory budgets
SQLITE_DB_PATH=./data/companion.db
USER_MD_MAX_CHARS=1500
MEMORY_MD_MAX_CHARS=2200

# Eval: set LLM_PROVIDER=mock for deterministic <2s run; live Bedrock eval: LLM_PROVIDER=bedrock
